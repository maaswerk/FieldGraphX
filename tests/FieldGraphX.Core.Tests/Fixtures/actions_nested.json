{
  "properties": {
    "definition": {
      "triggers": {
        "When_a_row_is_modified": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": { "operationId": "SubscribeWebhookTrigger" },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "msdyn_workorder",
              "subscriptionRequest/filteringattributes": "msdyn_name"
            }
          }
        }
      },
      "actions": {
        "Scope_Try": {
          "type": "Scope",
          "actions": {
            "Condition": {
              "type": "If",
              "expression": { "equals": ["@triggerOutputs()?['body/statuscode']", 1] },
              "actions": {
                "Apply_to_each": {
                  "type": "Foreach",
                  "foreach": "@outputs('List_rows')?['body/value']",
                  "actions": {
                    "Update_booking": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "UpdateRecord",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "bookableresourcebookings",
                          "recordId": "@items('Apply_to_each')?['bookableresourcebookingid']",
                          "item/msdyn_workordertravelstatus": 690970002,
                          "item/name": "@triggerOutputs()?['body/msdyn_name']"
                        }
                      }
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Create_task": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_commondataserviceforapps",
                        "operationId": "CreateRecord"
                      },
                      "parameters": {
                        "entityName": "tasks",
                        "item/subject": "Follow up",
                        "item/regardingobjectid_msdyn_workorder@odata.bind": "msdyn_workorders(@{triggerOutputs()?['body/msdyn_workorderid']})"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
